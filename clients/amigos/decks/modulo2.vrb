\frametitle{Recapitulando el Módulo}


\textbf{Hoy hemos aprendido:}
\begin{itemize}
  \item Dejar de usar palabras clave y empezar a dar contexto.
  \item Los \textbf{5 Pilares} garantizan resultados útiles y predecibles.
